# Copy to .env (gitignored) and fill in locally. Never commit real values.

# Anthropic API key. Needed only for discovery runs; replay and tests never use it.
ANTHROPIC_API_KEY=

# Optional. Context7 developer-docs MCP server (read by .mcp.json).
CONTEXT7_API_KEY=

# Claude model for discovery (default: claude-sonnet-5-5).
IDP_MODEL=

# Synthetic mock-bank operator login (credential ref `mockbank-operator`). The seed pair is documented in
# apps/mock-bank/README.md; it is synthetic, not a real credential.
MOCKBANK_OPERATOR_USER=
MOCKBANK_OPERATOR_PASSWORD=

# Ports. Defaults: mock-bank 4010, session control API 4020, operator console 4030.
MOCKBANK_PORT=
IDP_CONTROL_PORT=
IDP_OPERATOR_PORT=
