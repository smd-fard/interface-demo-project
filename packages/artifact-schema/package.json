{
	"name": "@idp/artifact-schema",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schemas/*": "./schemas/*"
	},
	"files": [
		"dist",
		"schemas"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rimraf dist",
		"fixtures:hash": "tsx scripts/hash-fixtures.ts",
		"schemas:export": "tsx scripts/export-json-schema.ts"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@idp/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"prettier": "catalog:",
		"rimraf": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
