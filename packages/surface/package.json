{
	"name": "@idp/surface",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:functional": "vitest run --config vitest.functional.config.ts",
		"test:watch": "vitest",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@idp/artifact-schema": "workspace:*",
		"@idp/policy": "workspace:*",
		"@idp/evidence": "workspace:*",
		"playwright": "catalog:"
	},
	"devDependencies": {
		"@idp/typescript-config": "workspace:*",
		"@types/node": "catalog:",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
